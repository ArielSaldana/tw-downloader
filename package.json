{
  "name": "tw-downloader",
  "version": "0.1.0",
  "private": true,
  "description": "Auditable, dependency-free Chrome extension for saving Twitter videos and images",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "node scripts/check.mjs && prettier --check .",
    "format": "prettier --write . && node scripts/build.mjs",
    "package": "node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
